# Supabase への接続情報
#
# このファイルを .env.local にコピーして値を入れる。
# 値は Supabase ダッシュボードの Project Settings → API で確認できる。
#
# 未設定でもアプリは動く。その場合、結果は画面に表示されるだけで保存されない。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 注意: service_role キーはここに書かない。
# ブラウザへ配信される値なので、書くと誰でも全データを操作できてしまう。
# 分析用ノートブックで使う場合は analysis/.env に置く (git 管理外)。
